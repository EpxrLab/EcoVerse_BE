@startuml seq_school_deliver_reward
title Sequence Diagram - PUT /api/school/rewards/requests/{id}/deliver (Trường giao quà cho học sinh)

actor "Trường học" as user
boundary "School Reward UI\n(Frontend)" as ui
participant "RewardRequestController" as ctrl
participant "IRewardRequestService\n(RewardRequestServiceImpl)" as svc
participant "SchoolRepository" as schoolRepo
participant "RewardRequestRepository" as rrRepo
participant "ApplicationEventPublisher" as eventPub
database "Database" as db

user -> ui : Xem yêu cầu đổi quà trạng thái APPROVED
activate ui

user -> ui : Upload ảnh bằng chứng giao quà\nvà nhấn "Xác nhận giao quà"

ui -> ctrl : PUT /api/school/rewards/requests/{id}/deliver\n{ "imageUrl": "s3-key" }
activate ctrl

ctrl -> svc : markDelivered(requestId, imageUrl)
activate svc

svc -> svc : getCurrentUser() → User
svc -> schoolRepo : findByUserId(userId)
activate schoolRepo
schoolRepo --> svc : School
deactivate schoolRepo

svc -> rrRepo : findByIdAndSchoolId(requestId, schoolId)
activate rrRepo
rrRepo --> svc : Optional<RewardRequest>
deactivate rrRepo

alt status != APPROVED
    svc --> ctrl : throw BadRequestException\n("Chỉ có thể giao khi status là APPROVED")
end

svc -> svc : request.setStatus(DELIVERED)\nrequest.setDeliveredAt(now)\nrequest.setDeliveryImageUrl(imageUrl)

svc -> rrRepo : save(request)
activate rrRepo
rrRepo -> db : UPDATE reward_requests SET status=DELIVERED
db --> rrRepo : done
rrRepo --> svc : RewardRequest
deactivate rrRepo

svc -> eventPub : publishEvent(NotificationEvent)\n→ Thông báo phụ huynh cần xác nhận nhận quà
activate eventPub
eventPub --> svc : void
deactivate eventPub

svc --> ctrl : RewardRequestResponse
deactivate svc

ctrl --> ui : 200 OK\nResponseDto<RewardRequestResponse>
deactivate ctrl

ui -> ui : Hiển thị "Xác nhận giao quà thành công"
ui --> user : Cập nhật trạng thái → DELIVERED
deactivate ui

@enduml
