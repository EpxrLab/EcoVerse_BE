@startuml seq_school_deliver_partnership_reward
title Sequence Diagram - PUT /api/school/reward-deliveries/{id}/deliver (Trường giao quà Partnership cho học sinh)

actor "Trường học" as user
boundary "School UI\n(Frontend)" as ui
participant "CampaignRewardDeliveryController" as ctrl
participant "ICampaignRewardDeliveryService\n(CampaignRewardDeliveryServiceImpl)" as svc
participant "SchoolRepository" as schoolRepo
participant "CampaignRewardDeliveryRepository" as delRepo
participant "ApplicationEventPublisher" as eventPub
database "Database" as db

user -> ui : Xem quà trạng thái ARRIVED
activate ui
user -> ui : Upload ảnh bằng chứng giao quà\nvà nhấn "Xác nhận giao cho học sinh"

ui -> ctrl : PUT /api/school/reward-deliveries/{id}/deliver\n{ "deliveryImageUrl": "s3-key", "notes": "..." }
activate ctrl
note over ctrl : @PreAuthorize("hasAuthority('PARTNERSHIP_SCHOOL')")

ctrl -> svc : markDelivered(id, request)
activate svc

svc -> svc : getCurrentUser() → User
svc -> schoolRepo : findByUserId(userId)
activate schoolRepo
schoolRepo --> svc : School
deactivate schoolRepo

svc -> delRepo : findById(deliveryId)
activate delRepo
delRepo --> svc : CampaignRewardDelivery
deactivate delRepo

alt delivery không thuộc trường
    svc --> ctrl : throw BadRequestException
end

alt status != ARRIVED
    svc --> ctrl : throw BadRequestException
end

svc -> svc : delivery.setStatus(DELIVERED)\ndelivery.setDeliveredAt(now)\ndelivery.setDeliveredBy(currentUser)\ndelivery.setDeliveryImageUrl(imageUrl)

svc -> delRepo : save(delivery)
activate delRepo
delRepo -> db : UPDATE SET status=DELIVERED
db --> delRepo : done
delRepo --> svc : CampaignRewardDelivery
deactivate delRepo

svc -> eventPub : publishEvent → Thông báo Học sinh
svc -> eventPub : publishEvent → Thông báo Phụ huynh\n(cần xác nhận nhận quà)
svc -> eventPub : publishEvent → Thông báo Partnership

svc --> ctrl : CampaignRewardDeliveryResponse
deactivate svc

ctrl --> ui : 200 OK
deactivate ctrl

ui -> ui : Hiển thị "Giao quà thành công"
ui --> user : Cập nhật status → DELIVERED
deactivate ui

@enduml
