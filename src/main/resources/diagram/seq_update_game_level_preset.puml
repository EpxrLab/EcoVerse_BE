@startuml seq_update_game_level_preset
title Sequence Diagram - PUT /api/admin/game-types/{gameTypeId}/presets/{presetId} (Update Game Level Preset)

actor "Admin" as admin
boundary "Admin UI\n(Frontend)" as ui
participant "AdminController" as ctrl
participant "IAdminService\n(AdminServiceImpl)" as svc
participant "GameTypeRepository" as gtRepo
participant "GameLevelPresetRepository" as glpRepo
database "Database" as db

admin -> ui : Open page Details Preset
activate ui
ui -> ui : Display thông tin Preset hiện tại\nvà List of level items

admin -> ui : Click button "Chỉnh sửa"
ui -> ui : Display form Edit Preset\nvới data current pre-filled\n(difficulty, items list)

admin -> ui : Edit thông tin preset\n(thay đổi difficulty, Add/Edit/xóa items)
admin -> ui : Click "Cập nhật"
ui -> ui : Validate form client side

ui -> ctrl : PUT /api/admin/game-types/{gameTypeId}/presets/{presetId}\n@RequestBody AdminGameLevelPresetUpsertRequest
activate ctrl
ctrl -> ctrl : @Valid validate request

ctrl -> svc : updateGameLevelPreset(gameTypeId, presetId, request)
activate svc

note over svc : getActiveGameTypeOrThrow(gameTypeId)
svc -> gtRepo : findByIdAndIsDeleteFalse(gameTypeId)
activate gtRepo
gtRepo -> db : SELECT FROM game_types ...
db --> gtRepo : result
gtRepo --> svc : Optional<GameType>
deactivate gtRepo

alt GameType not found
 svc --> ctrl : throw NotFoundException("Không tìm thấy game type")
 ctrl --> ui : 404 Not Found
 ui -> ui : Display thông Report error
 ui --> admin : Display error
end

note over svc : getPresetOrThrow(gameTypeId, presetId)
svc -> glpRepo : findById(presetId)
activate glpRepo
glpRepo -> db : SELECT FROM game_level_presets\nWHERE id=?
db --> glpRepo : result
glpRepo --> svc : Optional<GameLevelPreset>
deactivate glpRepo

svc -> svc : filter: preset.gameType.id == gameTypeId

alt Preset not found or wrong gameType
 svc --> ctrl : throw NotFoundException("Không tìm thấy preset")
 ctrl --> ui : 404 Not Found
 ui --> admin : Display error
end

svc -> glpRepo : existsByGameTypeIdAndDifficultyAndIdNot(\ngameTypeId, difficulty, presetId)
activate glpRepo
glpRepo -> db : SELECT EXISTS ...
db --> glpRepo : boolean
glpRepo --> svc : boolean
deactivate glpRepo

alt another preset with same difficulty exists
 svc --> ctrl : throw BadRequestException("Preset cho difficulty này đã tồn tại")
 ctrl --> ui : 400 Bad Request
 ui --> admin : Display error on form
end

note over svc : applyPresetUpsert(preset, request)
svc -> svc : preset.setDifficulty(request.getDifficulty())
svc -> svc : Validate duplicate levelNumbers

loop for each item request
 alt existing item for levelNumber
 svc -> svc : update existing GameLevelPresetItem
 else new levelNumber
 svc -> svc : new GameLevelPresetItem()
 end
 svc -> svc : applyPresetItemRequest(item, itemRequest, preset)
end

svc -> svc : Validate: each item has >= 1 wasteCategory
svc -> svc : preset.getItems().clear()\npreset.getItems().addAll(newItems)

svc -> glpRepo : save(preset)
activate glpRepo
glpRepo -> db : UPDATE game_level_presets ...\nDELETE orphaned items\nINSERT/UPDATE preset_items\nINSERT/UPDATE waste_categories
db --> glpRepo : updated preset
glpRepo --> svc : GameLevelPreset
deactivate glpRepo

svc -> svc : mapGameLevelPreset(preset)

svc --> ctrl : AdminGameLevelPresetResponse
deactivate svc

ctrl -> ctrl : ResponseDto.success(response, "Cập nhật preset thành công")
ctrl --> ui : 200 OK\nResponseDto<AdminGameLevelPresetResponse>
deactivate ctrl

ui -> ui : Display notification Successfully\n"Cập nhật preset thành công"
ui -> ui : Update data Display
ui --> admin : Display Preset has been Update
deactivate ui

@enduml
