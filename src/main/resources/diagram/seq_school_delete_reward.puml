@startuml seq_school_delete_reward
title Sequence Diagram - DELETE /api/school/rewards/{rewardId} (Xóa mềm quà thưởng)

actor "Trường học" as user
boundary "School Reward UI\n(Frontend)" as ui
participant "RewardController" as ctrl
participant "IRewardService\n(RewardServiceImpl)" as svc
participant "SchoolRepository" as schoolRepo
participant "RewardRepository" as rewardRepo
database "Database" as db

user -> ui : Xem danh sách quà thưởng
activate ui
user -> ui : Nhấn nút "Xóa" trên quà cần xóa
ui -> ui : Hiển thị dialog xác nhận\n"Bạn có chắc muốn xóa quà này?"

user -> ui : Nhấn "Xác nhận"

ui -> ctrl : DELETE /api/school/rewards/{rewardId}
activate ctrl

ctrl -> svc : deleteReward(rewardId)
activate svc

svc -> svc : getCurrentUser() → User
svc -> schoolRepo : findByUserId(userId)
activate schoolRepo
schoolRepo --> svc : School
deactivate schoolRepo

svc -> rewardRepo : findByIdAndSchoolIdAndIsDeleteFalse(rewardId, schoolId)
activate rewardRepo
rewardRepo --> svc : Optional<Reward>
deactivate rewardRepo

alt quà không tìm thấy
    svc --> ctrl : throw NotFoundException
    ctrl --> ui : 404 Not Found
    ui --> user : Hiển thị lỗi
end

svc -> svc : reward.setIsDelete(true)

svc -> rewardRepo : save(reward)
activate rewardRepo
rewardRepo -> db : UPDATE rewards SET is_delete=true
db --> rewardRepo : done
rewardRepo --> svc : Reward
deactivate rewardRepo

svc --> ctrl : void
deactivate svc

ctrl --> ui : 200 OK\nResponseDto<Void>
deactivate ctrl

ui -> ui : Hiển thị "Xóa quà thành công"
ui -> ui : Xóa quà khỏi danh sách
ui --> user : Danh sách quà đã cập nhật
deactivate ui

@enduml
