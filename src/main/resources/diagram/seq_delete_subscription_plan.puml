@startuml seq_delete_subscription_plan
title Sequence Diagram - DELETE /api/subscription-plans/{id} (Xóa Gói đăng ký)

actor "Admin" as admin
boundary "Admin UI\n(Frontend)" as ui
participant "SubscriptionPlanController" as ctrl
participant "ISubscriptionPlanService\n(SubscriptionPlanServiceImpl)" as svc
participant "SubscriptionPlanRepository" as planRepo
database "Database" as db

admin -> ui : Xem danh sách gói đăng ký
activate ui

admin -> ui : Nhấn nút "Xóa" trên gói cần xóa
ui -> ui : Hiển thị dialog xác nhận\n"Bạn có chắc muốn xóa gói đăng ký này?"

admin -> ui : Nhấn "Xác nhận xóa"

ui -> ctrl : DELETE /api/subscription-plans/{id}
activate ctrl
note over ctrl : @PreAuthorize("hasAuthority('ADMINISTRATOR')")

ctrl -> svc : deletePlan(id)
activate svc

svc -> planRepo : findById(id)
activate planRepo
planRepo -> db : SELECT FROM subscription_plans WHERE id=?
db --> planRepo : result
planRepo --> svc : Optional<SubscriptionPlan>
deactivate planRepo

alt plan not found
    svc --> ctrl : throw ResourceNotFoundException
    ctrl --> ui : 404 Not Found
    ui --> admin : Hiển thị lỗi
end

svc -> planRepo : delete(plan)
activate planRepo
planRepo -> db : DELETE FROM subscription_plans WHERE id=?
db --> planRepo : done
planRepo --> svc : void
deactivate planRepo

svc --> ctrl : void
deactivate svc

ctrl -> ctrl : ResponseDto.success(null,\n"Subscription plan deleted successfully.")
ctrl --> ui : 200 OK\nResponseDto<Void>
deactivate ctrl

ui -> ui : Hiển thị thông báo thành công
ui -> ui : Xóa gói khỏi danh sách
ui --> admin : Danh sách gói đã cập nhật
deactivate ui

@enduml
