@startuml seq_school_approve_reject_reward_request
title Sequence Diagram - PUT /api/school/rewards/requests/{id}/approve (Duyệt/Từ chối yêu cầu đổi quà)

actor "Trường học" as user
boundary "School Reward UI\n(Frontend)" as ui
participant "RewardRequestController" as ctrl
participant "IRewardRequestService\n(RewardRequestServiceImpl)" as svc
participant "SchoolRepository" as schoolRepo
participant "RewardRequestRepository" as rrRepo
participant "RewardRepository" as rewardRepo
participant "StudentRepository" as stuRepo
participant "CoinTransactionRepository" as txRepo
participant "ApplicationEventPublisher" as eventPub
database "Database" as db

user -> ui : Xem yêu cầu đổi quà PENDING
activate ui

user -> ui : Nhấn "Duyệt" hoặc "Từ chối"\n(nếu từ chối: nhập lý do)

ui -> ctrl : PUT /api/school/rewards/requests/{id}/approve\n{ "approved": true/false, "reason": "..." }
activate ctrl
note over ctrl : @PreAuthorize("hasAuthority('PARTNERSHIP_SCHOOL')")

ctrl -> svc : approveOrRejectRequest(requestId, dto)
activate svc

svc -> svc : getCurrentUser() → User
svc -> schoolRepo : findByUserId(userId)
activate schoolRepo
schoolRepo --> svc : School
deactivate schoolRepo

svc -> rrRepo : findByIdAndSchoolId(requestId, schoolId)
activate rrRepo
rrRepo --> svc : Optional<RewardRequest>
deactivate rrRepo

alt request not found
    svc --> ctrl : throw NotFoundException
end

alt status != PENDING
    svc --> ctrl : throw BadRequestException\n("Chỉ có thể duyệt khi status là PENDING")
end

alt dto.approved == true
    svc -> svc : request.setStatus(APPROVED)\nrequest.setApprovedAt(now)
else dto.approved == false
    svc -> svc : request.setStatus(REJECTED)\nrequest.setRejectedReason(reason)\nrequest.setRejectedAt(now)

    note over svc : Hoàn coin cho học sinh
    svc -> stuRepo : save(student) [totalCoins += totalCoins]
    svc -> txRepo : save(CoinTransaction REFUND)

    note over svc : Hoàn stock cho reward
    svc -> rewardRepo : save(reward) [stockQuantity += quantity]
end

svc -> rrRepo : save(request)
activate rrRepo
rrRepo -> db : UPDATE reward_requests ...
db --> rrRepo : done
rrRepo --> svc : RewardRequest
deactivate rrRepo

svc -> eventPub : publishEvent(NotificationEvent)\n→ Thông báo học sinh + phụ huynh
activate eventPub
eventPub --> svc : void
deactivate eventPub

svc --> ctrl : RewardRequestResponse
deactivate svc

ctrl --> ui : 200 OK\nResponseDto<RewardRequestResponse>
deactivate ctrl

ui -> ui : Hiển thị thông báo thành công
ui -> ui : Cập nhật trạng thái yêu cầu
ui --> user : Hiển thị yêu cầu đã duyệt/từ chối
deactivate ui

@enduml
