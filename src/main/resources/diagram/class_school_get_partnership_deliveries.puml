@startuml class_school_get_partnership_deliveries
title Class Diagram - GET /api/school/campaigns/{campaignId}/reward-deliveries (Trường xem quà Partnership)

skinparam classAttributeIconSize 0

package "controller" {
    class CampaignRewardDeliveryController {
        - deliveryService : ICampaignRewardDeliveryService
        + getDeliveriesBySchool(campaignId: UUID, status: PartnershipRewardStatus) : ResponseEntity<ResponseDto<List<CampaignRewardDeliveryResponse>>>
    }
}

package "service" {
    interface ICampaignRewardDeliveryService {
        + getDeliveriesBySchool(campaignId: UUID, status: PartnershipRewardStatus) : List<CampaignRewardDeliveryResponse>
    }

    class CampaignRewardDeliveryServiceImpl implements ICampaignRewardDeliveryService {
        - deliveryRepository : CampaignRewardDeliveryRepository
        - schoolRepository : SchoolRepository
        - s3PresignedUrlService : S3PresignedUrlService
        + getDeliveriesBySchool(...) : List<CampaignRewardDeliveryResponse>
    }
}

package "repository" {
    interface CampaignRewardDeliveryRepository extends JpaRepository {
        + findBySchoolIdAndCampaignIdAndStatusOrderByLeaderboardRankAsc(schoolId: UUID, campaignId: UUID, status: PartnershipRewardStatus) : List<CampaignRewardDelivery>
        + findBySchoolIdAndCampaignIdOrderByLeaderboardRankAsc(schoolId: UUID, campaignId: UUID) : List<CampaignRewardDelivery>
    }
}

CampaignRewardDeliveryController --> ICampaignRewardDeliveryService : uses

@enduml
