@startuml seq_verify_otp
title Sequence Diagram - POST /api/auth/verify-otp (Xác thực OTP)

actor "Người dùng" as user
boundary "Registration UI\n(Frontend)" as ui
participant "AuthenticationController" as ctrl
participant "IAuthenticationService\n(AuthenticationServiceImpl)" as svc
participant "IOtpService" as otpSvc

user -> ui : Nhập mã OTP nhận được từ email
activate ui

user -> ui : Nhấn "Xác thực OTP"
ui -> ui : Validate form (email, otp không trống)

ui -> ctrl : POST /api/auth/verify-otp\n{ "email": "user@example.com", "otp": "123456" }
activate ctrl
ctrl -> ctrl : @Valid validate VerifyOtpRequest

ctrl -> svc : verifyOtpOrThrow(email, otp)
activate svc

svc -> otpSvc : verifyOtp(email, otp)
activate otpSvc
otpSvc --> svc : boolean (true/false)
deactivate otpSvc

alt OTP không hợp lệ hoặc hết hạn
    svc --> ctrl : throw NotFoundException("OTP không hợp lệ hoặc đã hết hạn")
    ctrl --> ui : 404 Not Found
    ui -> ui : Hiển thị lỗi "OTP không hợp lệ"
    ui --> user : Hiển thị lỗi
end

svc -> otpSvc : markAsVerified(email)
activate otpSvc
otpSvc --> svc : void
deactivate otpSvc

svc --> ctrl : void
deactivate svc

ctrl -> ctrl : ResponseDto.success(null, "Xác thực otp thành công")
ctrl --> ui : 200 OK\nResponseDto<Void>
deactivate ctrl

ui -> ui : Hiển thị thông báo "OTP xác thực thành công"
ui -> ui : Chuyển sang form điền thông tin đăng ký\n(School hoặc Partnership)
ui --> user : Hiển thị form đăng ký chi tiết
deactivate ui

@enduml
