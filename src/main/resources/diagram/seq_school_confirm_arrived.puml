@startuml seq_school_confirm_arrived
title Sequence Diagram - PUT /api/school/reward-deliveries/{id}/arrived (Trường xác nhận nhận quà từ Partnership)

actor "Trường học" as user
boundary "School UI\n(Frontend)" as ui
participant "CampaignRewardDeliveryController" as ctrl
participant "ICampaignRewardDeliveryService\n(CampaignRewardDeliveryServiceImpl)" as svc
participant "SchoolRepository" as schoolRepo
participant "CampaignRewardDeliveryRepository" as delRepo
participant "ApplicationEventPublisher" as eventPub
database "Database" as db

user -> ui : Xem quà trạng thái SHIPPING
activate ui
user -> ui : Nhấn "Xác nhận đã nhận hàng"

ui -> ctrl : PUT /api/school/reward-deliveries/{id}/arrived
activate ctrl
note over ctrl : @PreAuthorize("hasAuthority('PARTNERSHIP_SCHOOL')")

ctrl -> svc : confirmArrived(id)
activate svc

svc -> svc : getCurrentUser() → User
svc -> schoolRepo : findByUserId(userId)
activate schoolRepo
schoolRepo --> svc : School
deactivate schoolRepo

svc -> delRepo : findById(deliveryId)
activate delRepo
delRepo --> svc : CampaignRewardDelivery
deactivate delRepo

alt delivery không thuộc trường này
    svc --> ctrl : throw BadRequestException
end

alt status != SHIPPING
    svc --> ctrl : throw BadRequestException
end

svc -> svc : delivery.setStatus(ARRIVED)\ndelivery.setArrivedAt(now)\ndelivery.setArrivedConfirmedBy(currentUser)

svc -> delRepo : save(delivery)
activate delRepo
delRepo -> db : UPDATE SET status=ARRIVED
db --> delRepo : done
delRepo --> svc : CampaignRewardDelivery
deactivate delRepo

svc -> eventPub : publishEvent → Thông báo Học sinh
svc -> eventPub : publishEvent → Thông báo Phụ huynh
svc -> eventPub : publishEvent → Thông báo Partnership

svc --> ctrl : CampaignRewardDeliveryResponse
deactivate svc

ctrl --> ui : 200 OK
deactivate ctrl

ui -> ui : Hiển thị "Xác nhận nhận quà thành công"
ui --> user : Cập nhật status → ARRIVED
deactivate ui

@enduml
