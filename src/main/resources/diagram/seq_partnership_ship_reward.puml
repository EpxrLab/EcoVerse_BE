@startuml seq_partnership_ship_reward
title Sequence Diagram - PUT /api/partnership/reward-deliveries/{id}/ship (Partnership Send reward)

actor "Partnership" as user
boundary "Partnership UI\n(Frontend)" as ui
participant "CampaignRewardDeliveryController" as ctrl
participant "ICampaignRewardDeliveryService\n(CampaignRewardDeliveryServiceImpl)" as svc
participant "PartnershipRepository" as partRepo
participant "CampaignRewardDeliveryRepository" as delRepo
participant "ApplicationEventPublisher" as eventPub
database "Database" as db

user -> ui : View List of reward status PREPARING
activate ui
user -> ui : Click "Gửi quà", Enter code vận đơn (tùy Select)

ui -> ctrl : PUT /api/partnership/reward-deliveries/{id}/ship\n{ "trackingCode": "VN123456", "notes": "..." }
activate ctrl
note over ctrl : @PreAuthorize("hasAuthority('THIRD_PARTY_PARTNERSHIP')")

ctrl -> svc : shipReward(id, request)
activate svc

svc -> svc : getCurrentUser() → User
svc -> partRepo : findByUserId(userId)
activate partRepo
partRepo --> svc : Partnership
deactivate partRepo

svc -> delRepo : findById(deliveryId)
activate delRepo
delRepo --> svc : CampaignRewardDelivery
deactivate delRepo

svc -> svc : Check campaign thuộc partnership

alt delivery not thuộc partnership this svc --> ctrl : throw BadRequestException\n("Bạn không có quyền")
end

alt status != PREPARING
 svc --> ctrl : throw BadRequestException\n("Chỉ có thể ship khi status là PREPARING")
end

svc -> svc : delivery.setStatus(SHIPPING)\ndelivery.setShippedAt(now)\ndelivery.setShippingTrackingCode(trackingCode)

svc -> delRepo : save(delivery)
activate delRepo
delRepo -> db : UPDATE SET status=SHIPPING, ...
db --> delRepo : done
delRepo --> svc : CampaignRewardDelivery
deactivate delRepo

svc -> eventPub : publishEvent → notification Student
svc -> eventPub : publishEvent → notification Parent
svc -> eventPub : publishEvent → notification Trường

svc --> ctrl : CampaignRewardDeliveryResponse
deactivate svc

ctrl --> ui : 200 OK\nResponseDto<CampaignRewardDeliveryResponse>
deactivate ctrl

ui -> ui : Display "Gửi quà thành công"
ui --> user : Update status → SHIPPING
deactivate ui

@enduml
