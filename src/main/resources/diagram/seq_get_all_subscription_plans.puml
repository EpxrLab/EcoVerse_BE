@startuml seq_get_all_subscription_plans
title Sequence Diagram - GET /api/subscription-plans (Lấy List of Subscription plan)

actor "Người dùng" as user
boundary "UI\n(Frontend)" as ui
participant "SubscriptionPlanController" as ctrl
participant "ISubscriptionPlanService\n(SubscriptionPlanServiceImpl)" as svc
participant "SubscriptionPlanRepository" as planRepo
participant "SubscriptionPlanMapper" as mapper
database "Database" as db

user -> ui : Open page Select Subscription plan
activate ui
ui -> ui : Chuẩn be filter params\n(subscriberType, isActive, keyword)

ui -> ctrl : GET /api/subscription-plans\n?subscriberType=SCHOOL&isActive=true\n&keyword=&page=0&size=10
activate ctrl

ctrl -> svc : getAllPlans(subscriberType, isActive, keyword, pageable)
activate svc

svc -> svc : Build Specification<SubscriptionPlan>\n(filter by subscriberType, isActive, keyword)

svc -> planRepo : findAll(spec, pageable)
activate planRepo
planRepo -> db : SELECT * FROM subscription_plans\nWHERE conditions\nORDER BY display_order ASC
db --> planRepo : Page<SubscriptionPlan>
planRepo --> svc : Page<SubscriptionPlan>
deactivate planRepo

svc -> svc : PageResponse.from(page, mapper::toResponse)

loop for each SubscriptionPlan in page
 svc -> mapper : toResponse(plan)
 activate mapper
 mapper --> svc : SubscriptionPlanResponse
 deactivate mapper
end

svc --> ctrl : PageResponse<SubscriptionPlanResponse>
deactivate svc

ctrl -> ctrl : ResponseDto.success(response,\n"Subscription plans retrieved successfully.")
ctrl --> ui : 200 OK\nResponseDto<PageResponse<SubscriptionPlanResponse>>
deactivate ctrl

ui -> ui : Render List of Subscription plan\n(planName, price, durationDays,\nmaxStudents, features, ...)
ui --> user : Display List of plan
deactivate ui

@enduml
