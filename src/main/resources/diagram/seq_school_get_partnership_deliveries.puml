@startuml seq_school_get_partnership_deliveries
title Sequence Diagram - GET /api/school/campaigns/{campaignId}/reward-deliveries (Trường View reward Partnership)

actor "Trường học" as user
boundary "School UI\n(Frontend)" as ui
participant "CampaignRewardDeliveryController" as ctrl
participant "ICampaignRewardDeliveryService\n(CampaignRewardDeliveryServiceImpl)" as svc
participant "SchoolRepository" as schoolRepo
participant "CampaignRewardDeliveryRepository" as delRepo
participant "S3PresignedUrlService" as s3Svc
database "Database" as db

user -> ui : Open chiến dịch Partnership → tab "Quà thưởng"
activate ui

ui -> ctrl : GET /api/school/campaigns/{campaignId}/reward-deliveries\n?status=ARRIVED
activate ctrl
note over ctrl : @PreAuthorize("hasAuthority('PARTNERSHIP_SCHOOL')")

ctrl -> svc : getDeliveriesBySchool(campaignId, status)
activate svc

svc -> svc : getCurrentUser() → User
svc -> schoolRepo : findByUserId(userId)
activate schoolRepo
schoolRepo --> svc : School
deactivate schoolRepo

alt status != null
 svc -> delRepo : findBySchoolIdAndCampaignIdAndStatusOrderByLeaderboardRankAsc(schoolId, campaignId, status)
else
 svc -> delRepo : findBySchoolIdAndCampaignIdOrderByLeaderboardRankAsc(schoolId, campaignId)
end
activate delRepo
delRepo -> db : SELECT FROM campaign_reward_deliveries ...
db --> delRepo : List<CampaignRewardDelivery>
delRepo --> svc : List<CampaignRewardDelivery>
deactivate delRepo

loop for each delivery
 svc -> s3Svc : generatePresignedUrl(rewardImageUrl)
 svc -> svc : mapToResponse(delivery)
end

svc --> ctrl : List<CampaignRewardDeliveryResponse>
deactivate svc

ctrl --> ui : 200 OK
deactivate ctrl

ui -> ui : Render Table reward\n(studentName, rewardName, rank,\nstatus, trackingCode)
ui --> user : Display List of reward
deactivate ui

@enduml
