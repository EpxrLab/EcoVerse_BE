@startuml seq_school_get_reward_requests
title Sequence Diagram - GET /api/school/rewards/requests (Trường View Reward request)

actor "Trường học" as user
boundary "School Reward UI\n(Frontend)" as ui
participant "RewardRequestController" as ctrl
participant "IRewardRequestService\n(RewardRequestServiceImpl)" as svc
participant "SchoolRepository" as schoolRepo
participant "RewardRequestRepository" as rrRepo
participant "S3PresignedUrlService" as s3Svc
database "Database" as db

user -> ui : Open page "Yêu cầu đổi quà"
activate ui

ui -> ctrl : GET /api/school/rewards/requests?status=PENDING
activate ctrl
note over ctrl : @PreAuthorize("hasAuthority('PARTNERSHIP_SCHOOL')")

ctrl -> svc : getSchoolRequests(status)
activate svc

svc -> svc : getCurrentUser() → User
svc -> schoolRepo : findByUserId(userId)
activate schoolRepo
schoolRepo --> svc : School
deactivate schoolRepo

alt status != null
 svc -> rrRepo : findBySchoolIdAndStatusOrderByCreatedAtDesc(schoolId, status)
else
 svc -> rrRepo : findBySchoolIdOrderByCreatedAtDesc(schoolId)
end
activate rrRepo
rrRepo -> db : SELECT FROM reward_requests WHERE ...
db --> rrRepo : List<RewardRequest>
rrRepo --> svc : List<RewardRequest>
deactivate rrRepo

loop for each RewardRequest
 svc -> s3Svc : generatePresignedUrl(rewardImageUrl)
 svc -> svc : mapToResponse(request)
end

svc --> ctrl : List<RewardRequestResponse>
deactivate svc

ctrl --> ui : 200 OK\nResponseDto<List<RewardRequestResponse>>
deactivate ctrl

ui -> ui : Render Table Request\n(requestCode, studentName, rewardName,\nquantity, totalCoins, status)
ui --> user : Display List of Request
deactivate ui

@enduml
