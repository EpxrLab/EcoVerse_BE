@startuml class_get_my_partnership_deliveries
title Class Diagram - GET /api/rewards/deliveries/my (Xem lịch sử nhận quà Partnership)

skinparam classAttributeIconSize 0

package "controller" {
    class CampaignRewardDeliveryController {
        - deliveryService : ICampaignRewardDeliveryService
        + getMyDeliveries() : ResponseEntity<ResponseDto<List<CampaignRewardDeliveryResponse>>>
    }
}

package "service" {
    interface ICampaignRewardDeliveryService {
        + getMyDeliveries() : List<CampaignRewardDeliveryResponse>
    }

    class CampaignRewardDeliveryServiceImpl implements ICampaignRewardDeliveryService {
        - deliveryRepository : CampaignRewardDeliveryRepository
        - studentRepository : StudentRepository
        - parentRepository : ParentRepository
        - studentParentLinkRepository : StudentParentLinkRepository
        - s3PresignedUrlService : S3PresignedUrlService
        + getMyDeliveries() : List<CampaignRewardDeliveryResponse>
    }
}

package "dto.response" {
    class CampaignRewardDeliveryResponse {
        - id : UUID
        - campaignId : UUID
        - campaignName : String
        - rewardName : String
        - studentName : String
        - schoolName : String
        - leaderboardRank : Integer
        - totalScore : Double
        - status : PartnershipRewardStatus
        - rewardImagePresignedUrl : String
        - deliveryImagePresignedUrl : String
    }
}

package "repository" {
    interface CampaignRewardDeliveryRepository extends JpaRepository {
        + findByStudentIdOrderByCreatedAtDesc(studentId: UUID) : List<CampaignRewardDelivery>
    }
}

CampaignRewardDeliveryController --> ICampaignRewardDeliveryService : uses

@enduml
