@startuml seq_create_game_type
title Sequence Diagram - POST /api/admin/game-types (Create Game Type)

actor "Admin" as admin
boundary "Admin UI\n(Frontend)" as ui
participant "AdminController" as ctrl
participant "IAdminService\n(AdminServiceImpl)" as svc
participant "GameTypeRepository" as gtRepo
participant "S3PresignedUrlService" as s3
participant "SecurityContextHolder" as sec
database "Database" as db

admin -> ui : Nhấn vào menu "Quản lý Game Type"
activate ui
ui -> ui : Hiển thị trang danh sách Game Type\nvới nút "Tạo mới"

admin -> ui : Nhấn nút "Tạo mới Game Type"
ui -> ui : Hiển thị form tạo Game Type\n(typeCode, name, shortDescription,\nfullDescription, howToPlay,\nthumbnailUrl, iconUrl, features,\nsupportsCoin, maxLevels, displayOrder)

admin -> ui : Điền thông tin và nhấn "Lưu"
ui -> ui : Validate form phía client

ui -> ctrl : POST /api/admin/game-types\n@RequestBody AdminGameTypeUpsertRequest
activate ctrl
ctrl -> ctrl : @Valid validate request

ctrl -> svc : createGameType(request)
activate svc

svc -> gtRepo : existsByTypeCodeAndIsDeleteFalse(request.getTypeCode())
activate gtRepo
gtRepo -> db : SELECT EXISTS ...
db --> gtRepo : result
gtRepo --> svc : boolean
deactivate gtRepo

alt typeCode already exists
    svc --> ctrl : throw BadRequestException("Game type code đã tồn tại")
    ctrl --> ui : 400 Bad Request
    ui -> ui : Hiển thị thông báo lỗi\n"Game type code đã tồn tại"
    ui --> admin : Hiển thị lỗi trên form
end

svc -> gtRepo : existsByNameIgnoreCaseAndIsDeleteFalse(request.getName())
activate gtRepo
gtRepo -> db : SELECT EXISTS ...
db --> gtRepo : result
gtRepo --> svc : boolean
deactivate gtRepo

alt name already exists
    svc --> ctrl : throw BadRequestException("Tên game type đã tồn tại")
    ctrl --> ui : 400 Bad Request
    ui -> ui : Hiển thị thông báo lỗi\n"Tên game type đã tồn tại"
    ui --> admin : Hiển thị lỗi trên form
end

svc -> svc : new GameType()
svc -> svc : set typeCode, name, shortDescription,\nfullDescription, howToPlay, thumbnailUrl,\niconUrl, features, supportsCoin,\nmaxLevels, displayOrder

svc -> sec : getCurrentAdmin()
activate sec
sec --> svc : User (admin)
deactivate sec

svc -> svc : gameType.setCreatedBy(admin)\ngameType.setUpdatedBy(admin)

svc -> gtRepo : save(gameType)
activate gtRepo
gtRepo -> db : INSERT INTO game_types ...
db --> gtRepo : saved GameType
gtRepo --> svc : GameType
deactivate gtRepo

svc -> svc : mapGameType(gameType)
svc -> s3 : generatePresignedUrl(thumbnailUrl)
activate s3
s3 --> svc : presigned thumbnail URL
deactivate s3

svc -> s3 : generatePresignedUrl(iconUrl)
activate s3
s3 --> svc : presigned icon URL
deactivate s3

svc --> ctrl : AdminGameTypeResponse
deactivate svc

ctrl -> ctrl : ResponseDto.created(response, "Tạo game type thành công")
ctrl --> ui : 201 Created\nResponseDto<AdminGameTypeResponse>
deactivate ctrl

ui -> ui : Hiển thị thông báo thành công\n"Tạo game type thành công"
ui -> ui : Cập nhật danh sách Game Type
ui --> admin : Hiển thị Game Type mới
deactivate ui

@enduml
