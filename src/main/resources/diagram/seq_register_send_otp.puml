@startuml seq_register_send_otp
title Sequence Diagram - POST /api/auth/register (Gửi OTP đăng ký)

actor "Người dùng" as user
boundary "Registration UI\n(Frontend)" as ui
participant "AuthenticationController" as ctrl
participant "IAuthenticationService\n(AuthenticationServiceImpl)" as svc
participant "UserRepository" as userRepo
participant "IOtpService" as otpSvc
participant "IEmailService" as emailSvc
database "Database" as db

user -> ui : Truy cập trang đăng ký
activate ui
ui -> ui : Hiển thị form nhập email

user -> ui : Nhập email và nhấn "Gửi OTP"
ui -> ui : Validate email format phía client

ui -> ctrl : POST /api/auth/register\n{ "email": "user@example.com" }
activate ctrl
ctrl -> ctrl : @Valid validate RegisterRequest

ctrl -> svc : register(registerRequest)
activate svc

svc -> userRepo : existsByEmail(email)
activate userRepo
userRepo -> db : SELECT EXISTS FROM users\nWHERE email=?
db --> userRepo : boolean
userRepo --> svc : boolean
deactivate userRepo

alt email đã tồn tại
    svc --> ctrl : throw DuplicateEntity("Email này đã được sử dụng!")
    ctrl --> ui : 409 Conflict
    ui -> ui : Hiển thị lỗi "Email đã được sử dụng"
    ui --> user : Hiển thị lỗi
end

svc -> otpSvc : generateOtp(email)
activate otpSvc
otpSvc --> svc : OTP code (6 digits)
deactivate otpSvc

svc -> emailSvc : sendOtpEmail(email, otp)
activate emailSvc
emailSvc -> emailSvc : Gửi email chứa mã OTP
emailSvc --> svc : void
deactivate emailSvc

svc --> ctrl : void
deactivate svc

ctrl -> ctrl : ResponseDto.success(null, "Please check mail to get OTP")
ctrl --> ui : 200 OK\nResponseDto<String>
deactivate ctrl

ui -> ui : Hiển thị thông báo\n"Vui lòng kiểm tra email để lấy mã OTP"
ui -> ui : Chuyển sang form nhập OTP
ui --> user : Hiển thị form xác thực OTP
deactivate ui

@enduml
