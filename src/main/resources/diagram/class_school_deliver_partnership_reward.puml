@startuml class_school_deliver_partnership_reward
title Class Diagram - PUT /api/school/reward-deliveries/{id}/deliver (Trường giao quà Partnership)

skinparam classAttributeIconSize 0

package "controller" {
    class CampaignRewardDeliveryController {
        - deliveryService : ICampaignRewardDeliveryService
        + markDelivered(id: UUID, request: DeliverRewardDeliveryRequest) : ResponseEntity<ResponseDto<CampaignRewardDeliveryResponse>>
    }
}

package "service" {
    interface ICampaignRewardDeliveryService {
        + markDelivered(deliveryId: UUID, request: DeliverRewardDeliveryRequest) : CampaignRewardDeliveryResponse
    }

    class CampaignRewardDeliveryServiceImpl implements ICampaignRewardDeliveryService {
        - deliveryRepository : CampaignRewardDeliveryRepository
        - schoolRepository : SchoolRepository
        - eventPublisher : ApplicationEventPublisher
        + markDelivered(deliveryId: UUID, request: DeliverRewardDeliveryRequest) : CampaignRewardDeliveryResponse
    }
}

package "dto.request" {
    class DeliverRewardDeliveryRequest {
        - deliveryImageUrl : String <<@NotBlank>>
        - notes : String
    }
}

package "entity" {
    class CampaignRewardDelivery extends BaseEntity {
        - status : PartnershipRewardStatus
        - deliveredAt : LocalDateTime
        - deliveredBy : User
        - deliveryImageUrl : String
    }
}

CampaignRewardDeliveryController --> ICampaignRewardDeliveryService : uses

@enduml
