@startuml seq_get_my_partnership_deliveries
title Sequence Diagram - GET /api/rewards/deliveries/my (Xem lịch sử nhận quà Partnership)

actor "Học sinh/Phụ huynh" as user
boundary "Reward UI\n(Frontend)" as ui
participant "CampaignRewardDeliveryController" as ctrl
participant "ICampaignRewardDeliveryService\n(CampaignRewardDeliveryServiceImpl)" as svc
participant "StudentRepository" as stuRepo
participant "ParentRepository" as parRepo
participant "StudentParentLinkRepository" as splRepo
participant "CampaignRewardDeliveryRepository" as delRepo
participant "S3PresignedUrlService" as s3Svc
database "Database" as db

user -> ui : Mở trang "Quà từ chiến dịch"
activate ui

ui -> ctrl : GET /api/rewards/deliveries/my
activate ctrl
note over ctrl : @PreAuthorize("hasAnyAuthority('STUDENT', 'PARENT')")

ctrl -> svc : getMyDeliveries()
activate svc

svc -> svc : getCurrentUser() → User

alt role == STUDENT
    svc -> stuRepo : findByUserId(userId)
    activate stuRepo
    stuRepo --> svc : Student
    deactivate stuRepo
    svc -> delRepo : findByStudentIdOrderByCreatedAtDesc(studentId)
else role == PARENT
    svc -> parRepo : findByUserId(userId)
    activate parRepo
    parRepo --> svc : Parent
    deactivate parRepo
    svc -> splRepo : findByParentId(parentId)
    loop for each child
        svc -> delRepo : findByStudentIdOrderByCreatedAtDesc(childId)
    end
end

activate delRepo
delRepo -> db : SELECT FROM campaign_reward_deliveries ...
db --> delRepo : List<CampaignRewardDelivery>
delRepo --> svc : List<CampaignRewardDelivery>
deactivate delRepo

loop for each delivery
    svc -> s3Svc : generatePresignedUrl(rewardImageUrl)
    svc -> svc : mapToResponse(delivery)
end

svc --> ctrl : List<CampaignRewardDeliveryResponse>
deactivate svc

ctrl --> ui : 200 OK\nResponseDto<List<CampaignRewardDeliveryResponse>>
deactivate ctrl

ui -> ui : Render danh sách quà\n(campaignName, rewardName, rank,\nstatus, deliveryImageUrl)
ui --> user : Hiển thị lịch sử nhận quà
deactivate ui

@enduml
