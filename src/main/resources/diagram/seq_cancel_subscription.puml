@startuml seq_cancel_subscription
title Sequence Diagram - PATCH /api/subscriptions/{id}/cancel (Hủy Gói đăng ký)

actor "School/Partnership" as user
boundary "Subscription UI\n(Frontend)" as ui
participant "SubscriptionController" as ctrl
participant "ISubscriptionService\n(SubscriptionServiceImpl)" as svc
participant "SubscriptionRepository" as subRepo
database "Database" as db

user -> ui : Xem gói đăng ký đang chờ (PENDING_RENEWAL)
activate ui

user -> ui : Nhấn "Hủy gói"
ui -> ui : Hiển thị dialog xác nhận\n"Bạn có chắc muốn hủy gói này?"
ui -> ui : Hiển thị ô nhập lý do hủy (optional)

admin -> ui : Nhập lý do (nếu có) và nhấn "Xác nhận hủy"

ui -> ctrl : PATCH /api/subscriptions/{id}/cancel?reason=...
activate ctrl
note over ctrl : @PreAuthorize("hasAnyAuthority(\n'PARTNERSHIP_SCHOOL', 'THIRD_PARTY_PARTNERSHIP')")

ctrl -> svc : cancelSubscription(id, reason, userId)
activate svc

svc -> subRepo : findById(id)
activate subRepo
subRepo -> db : SELECT FROM subscriptions WHERE id=?
db --> subRepo : result
subRepo --> svc : Optional<Subscription>
deactivate subRepo

alt subscription not found
    svc --> ctrl : throw ResourceNotFoundException
    ctrl --> ui : 404 Not Found
    ui --> user : Hiển thị lỗi
end

alt status != PENDING_RENEWAL
    svc --> ctrl : throw FuncErrorException\n("Only pending renewal subscriptions can be cancelled.")
    ctrl --> ui : 400 Bad Request
    ui --> user : Hiển thị lỗi
end

svc -> svc : verifyOwnership(subscription, userId)

svc -> svc : subscription.setStatus(CANCELLED)
svc -> svc : subscription.setCancellationReason(reason)
svc -> svc : subscription.setCancelledAt(now)

svc -> subRepo : save(subscription)
activate subRepo
subRepo -> db : UPDATE subscriptions\nSET status=CANCELLED, ...
db --> subRepo : updated
subRepo --> svc : Subscription
deactivate subRepo

svc -> svc : toSubscriptionResponse(subscription)

svc --> ctrl : SubscriptionResponse
deactivate svc

ctrl -> ctrl : ResponseDto.success(response, "Subscription cancelled.")
ctrl --> ui : 200 OK\nResponseDto<SubscriptionResponse>
deactivate ctrl

ui -> ui : Hiển thị "Gói đăng ký đã được hủy"
ui -> ui : Cập nhật trạng thái gói
ui --> user : Hiển thị gói đã hủy
deactivate ui

@enduml
