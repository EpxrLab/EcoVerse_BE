@startuml seq_school_get_rewards
title Sequence Diagram - GET /api/school/rewards (Lấy danh sách quà của trường)

actor "Trường học" as user
boundary "School Reward UI\n(Frontend)" as ui
participant "RewardController" as ctrl
participant "IRewardService\n(RewardServiceImpl)" as svc
participant "SchoolRepository" as schoolRepo
participant "RewardRepository" as rewardRepo
participant "S3PresignedUrlService" as s3Svc
database "Database" as db

user -> ui : Mở trang quản lý quà thưởng
activate ui

ui -> ctrl : GET /api/school/rewards?rewardType=PHYSICAL
activate ctrl
note over ctrl : @PreAuthorize("hasAuthority('PARTNERSHIP_SCHOOL')")

ctrl -> svc : getRewardsForSchool(rewardType)
activate svc

svc -> svc : getCurrentUser() → User
svc -> schoolRepo : findByUserId(userId)
activate schoolRepo
schoolRepo --> svc : School
deactivate schoolRepo

alt rewardType != null
    svc -> rewardRepo : findBySchoolIdAndRewardTypeAndIsDeleteFalseOrderByCreatedAtDesc(schoolId, rewardType)
else rewardType == null
    svc -> rewardRepo : findBySchoolIdAndIsDeleteFalseOrderByCreatedAtDesc(schoolId)
end
activate rewardRepo
rewardRepo -> db : SELECT FROM rewards WHERE ...
db --> rewardRepo : List<Reward>
rewardRepo --> svc : List<Reward>
deactivate rewardRepo

loop for each Reward
    svc -> s3Svc : generatePresignedUrl(imageUrl)
    svc -> svc : mapToResponse(reward)
end

svc --> ctrl : List<RewardResponse>
deactivate svc

ctrl --> ui : 200 OK\nResponseDto<List<RewardResponse>>
deactivate ctrl

ui -> ui : Render danh sách quà\n(rewardName, coinCost, stockQuantity,\nrewardType, imagePresignedUrl)
ui --> user : Hiển thị danh sách quà
deactivate ui

@enduml
